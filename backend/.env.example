# ==========================================
# CodeMap Backend Environment Configuration
# ==========================================

# Application
PROJECT_NAME="CodeMap Backend API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=True

# Security & Session Authentication
# GENERATE A STRONG SECRET KEY FOR PRODUCTION (e.g., openssl rand -hex 32)
SECRET_KEY="codemap_stage2_dev_insecure_secret_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection (PostgreSQL or SQLite for local dev)
# Local SQLite example:
DATABASE_URL="sqlite+aiosqlite:///./codemap.db"
# PostgreSQL Production example:
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/codemap"

# Repository Storage Directory
STORAGE_DIR="storage_repos"

# Upload Protection Limits
MAX_ZIP_UPLOAD_SIZE_BYTES=52428800 # 50 MB
MAX_UNCOMPRESSED_SIZE_BYTES=262144000 # 250 MB
MAX_ZIP_FILES_COUNT=2500

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Optional GitHub Integration
# If left empty, CodeMap displays helpful setup guidance without failing or faking
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_APP_NAME=""
